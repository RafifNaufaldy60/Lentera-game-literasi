# Buat server/.env dari file ini jika belum memiliki konfigurasi.
# Jangan kirim file .env ke GitHub atau membagikan DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
APP_ORIGIN=http://localhost:5173
PORT=3001
# Gunakan: npm.cmd --prefix server run auth:setup
# SESSION_SECRET akan ditambahkan oleh perintah tersebut.
